rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isUnderSize(maxMegabytes) {
      return request.resource.size < maxMegabytes * 1024 * 1024;
    }

    // New namespaced paths
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isImage() && isUnderSize(5);
    }
    
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if isAuthenticated() 
                  && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.businessId == businessId;
      allow write: if isAuthenticated() 
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.businessId == businessId
                   && isImage() 
                   && isUnderSize(5);
    }

    // Legacy paths for old images (read-only)
    match /products/{allPaths=**} {
      allow read: if isAuthenticated();
    }
    match /customers/{allPaths=**} {
      allow read: if isAuthenticated();
    }
    match /profiles/{allPaths=**} {
      allow read: if isAuthenticated();
    }

    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
