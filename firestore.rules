rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to get the user's role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Function to get the user's businessId
    function getUserBusinessId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isEmployee() {
      return isAuthenticated() && (getUserRole() == 'employee' || getUserRole() == 'admin');
    }

    function hasValidBusinessId(data) {
      let userBizId = getUserBusinessId();
      return data == null || (userBizId != null && userBizId != "" && 'businessId' in data && data.businessId == userBizId);
    }

    // Businesses Collection
    match /businesses/{businessId} {
      // Restrict read to exact document gets or lists of maximum size 1
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && request.query.limit <= 1;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && businessId == getUserBusinessId() && isAdmin();

      match /settings/{settingId} {
        allow read: if isEmployee() && businessId == getUserBusinessId();
        allow write: if isAdmin() && businessId == getUserBusinessId();
      }
    }

    // Users Collection
    match /users/{userId} {
      // User can read their own profile to get their businessId/role, or admins of the same business can read it
      allow read: if isAuthenticated() && (request.auth.uid == userId || (isAdmin() && getUserBusinessId() != "" && resource.data.businessId == getUserBusinessId()));
      
      // User can create their own profile initially. Must not have a businessId or admin role.
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId
                    && request.resource.data.role in ['user', 'employee']
                    && (request.resource.data.businessId == null || request.resource.data.businessId == '');

      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && 
         (
           // Standard Profile Update: Cannot change core fields
           (request.resource.data.role == resource.data.role && 
            request.resource.data.status == resource.data.status && 
            (resource.data.businessId == null || request.resource.data.businessId == resource.data.businessId)) 
           ||
           // Initial Setup: If they have no business, they can join/create one
           ((resource.data.businessId == null || resource.data.businessId == "") && 
             request.resource.data.businessId != "" && 
             (
               (request.resource.data.role == 'admin' && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid) ||
               (request.resource.data.role == 'employee' && request.resource.data.status == 'pending')
             )
           )
           ||
           // Leaving Business: Allow a user to clear their businessId to leave
           (request.resource.data.businessId == "" && 
            request.resource.data.role == 'user' && 
            request.resource.data.status == 'active')
         )
        ) || 
        (isAdmin() && getUserBusinessId() != "" && resource.data.businessId == getUserBusinessId() && request.resource.data.businessId == getUserBusinessId())
      );
      
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId || 
        (isAdmin() && getUserBusinessId() != "" && resource.data.businessId == getUserBusinessId())
      );
    }

    // Collections that require Employee/Admin access and MUST match businessId
    match /products/{productId} {
      allow get: if isAuthenticated() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isAuthenticated() && hasValidBusinessId(resource.data);
      allow create: if isAdmin() && hasValidBusinessId(request.resource.data);
      allow update: if isAdmin() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isAdmin() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /categories/{categoryId} {
      allow get: if isAuthenticated() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isAuthenticated() && hasValidBusinessId(resource.data);
      allow create: if isAdmin() && hasValidBusinessId(request.resource.data);
      allow update: if isAdmin() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isAdmin() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /orders/{orderId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /order_items/{itemId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /customers/{customerId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /payments/{paymentId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /returns/{returnId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /return_items/{itemId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /purchases/{purchaseId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /purchaseItems/{itemId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /purchase_returns/{returnId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /purchase_return_items/{itemId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /suppliers/{supplierId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    match /supplierPayments/{paymentId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow get: if isAdmin() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isAdmin() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update, delete: if false; // Logs are immutable
    }

    // Counters (Sequences for invoices, orders)
    match /counters/{counterId} {
      allow get: if isEmployee() && (resource == null || hasValidBusinessId(resource.data));
      allow list: if isEmployee() && hasValidBusinessId(resource.data);
      allow create: if isEmployee() && hasValidBusinessId(request.resource.data);
      allow update: if isEmployee() && (resource == null || hasValidBusinessId(resource.data)) && hasValidBusinessId(request.resource.data);
      allow delete: if isAdmin() && (resource == null || hasValidBusinessId(resource.data));
    }
  }
}
